// הגדרות השרת – לא חובה. בלי קובץ config.json האתר עובד בפורט 8080 ורק עם מיילים של ncr.co.il.
// כדי לשנות: מעתיקים את הקובץ ל-config.json, מעדכנים ומפעילים מחדש את השרת.
// (מותר להשאיר את שורות ההסבר שמתחילות ב-//)
{
  "port": 8080,

  // הכתובת שבה הצוות נכנס לאתר (לא חובה – מוצגת בחלון השרת). ריק = שם השרת + הפורט
  "publicUrl": "",

  // רק מיילים מהדומיין הזה יכולים להירשם ולהתחבר
  "emailDomain": "ncr.co.il",

  // לא חובה: שליחת מיילים אוטומטית מהשרת (לאיפוס סיסמה). דורש אישור משרת המייל של החברה.
  // כשזה ריק (ברירת המחדל) – "שכחתי סיסמה" מגיע למנהל הצוות, והוא שולח קישור איפוס מהאאוטלוק שלו.
  "mail": {
    "host": "",
    "port": 25,
    "from": "דיווח שעות <hours@ncr.co.il>"
  },

  // HTTPS (לא חובה): קובץ תעודה pfx מה-IT. אם ריק – האתר עובד ב-http
  "https": {
    "pfxFile": "",
    "passphrase": ""
  }
}
